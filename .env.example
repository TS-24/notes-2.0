# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# docker-compose.yml reads these. Its own inline fallbacks differ (user and
# password both default to "postgres"), so set them here rather than relying
# on those.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notes_db
POSTGRES_PORT=5432

# Used by SQLAlchemy. Host is "db" inside compose and "localhost" outside it,
# since containers do not share the host's loopback.
DATABASE_URL=postgresql://postgres:change-me@db:5432/notes_db

# Optional. The hosted sense ranker; without HF_TOKEN the ladder falls back to
# WordNet's own ordering. These must live here rather than in your shell:
# docker-compose.yml forwards only the variables it names into the backend.
HF_TOKEN=
HF_MODEL=sentence-transformers/all-MiniLM-L6-v2
LADDER_RANKING=on
