# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# docker-compose.yml reads these and forwards only the variables it names into
# the containers.

# Host ports. These are a block unique to this project rather than the
# defaults, so a neighbouring project on 3000 does not collide. Only the host
# side moves: inside the compose network the frontend still listens on 3000
# and the backend on 8000, reached by service name.
FRONTEND_PORT=3700
BACKEND_PORT=8700

# Used by SQLAlchemy and by Alembic. The database is Neon, not a container, so
# this is the only thing that says where the data lives and compose no longer
# assembles it from POSTGRES_* parts.
#
# Use Neon's DIRECT endpoint, not the "-pooler" one. entrypoint.sh runs
# `alembic upgrade head` and uvicorn from this single variable, and migrations
# do not survive PgBouncer's transaction pooling. There is one backend
# container and SQLAlchemy pools in-process, so the pooler buys nothing here.
#
# sslmode=require is not optional: Neon refuses a plaintext connection.
# Dev and prod should point at different Neon BRANCHES, never the same one.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/restyle?sslmode=require

# Only used by docker-compose.prod.yml. The hostname Caddy gets a certificate
# for; it must resolve to the machine running the stack, and cannot be an IP.
DOMAIN=

# "development" or "production". Production serves no /docs and marks the
# session cookie Secure, which needs https to work at all.
ENVIRONMENT=development

# Signing key for access tokens. Required: the backend refuses to start
# without it, and refuses anything under 32 bytes. Generate with
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it invalidates every existing session, which is the only revocation
# lever there is.
JWT_SECRET=

# Signs the session cookie the frontend sets. Required, and separate from
# JWT_SECRET on purpose: one signs the token, the other the cookie carrying it,
# and they are held by different services. Rotating this signs everyone out,
# which is the only way to revoke a session that exists.
SESSION_SECRET=

# Optional. The hosted sense ranker; without HF_TOKEN the ladder falls back to
# WordNet's own ordering. These must live here rather than in your shell:
# docker-compose.yml forwards only the variables it names into the backend.
HF_TOKEN=
HF_MODEL=sentence-transformers/all-MiniLM-L6-v2
LADDER_RANKING=on
