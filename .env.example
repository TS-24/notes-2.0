# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# docker-compose.yml reads these. Its own inline fallbacks differ (user and
# password both default to "postgres"), so set them here rather than relying
# on those.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notes_db

# Host ports. These are a block unique to this project rather than the
# defaults, so a neighbouring project on 3000 or 5432 does not collide. Only
# the host side moves: inside the compose network the frontend still listens
# on 3000 and the backend on 8000, reached by service name.
FRONTEND_PORT=3700
BACKEND_PORT=8700
POSTGRES_PORT=5700

# Used by SQLAlchemy. Host is "db" inside compose and "localhost" outside it,
# since containers do not share the host's loopback.
DATABASE_URL=postgresql://postgres:change-me@db:5432/notes_db

# Only used by docker-compose.prod.yml. The hostname Caddy gets a certificate
# for; it must resolve to the machine running the stack, and cannot be an IP.
DOMAIN=

# "development" or "production". Production serves no /docs and marks the
# session cookie Secure, which needs https to work at all.
ENVIRONMENT=development

# Signing key for access tokens. Required: the backend refuses to start
# without it, and refuses anything under 32 bytes. Generate with
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it invalidates every existing session, which is the only revocation
# lever there is.
JWT_SECRET=

# Signs the session cookie the frontend sets. Required, and separate from
# JWT_SECRET on purpose: one signs the token, the other the cookie carrying it,
# and they are held by different services. Rotating this signs everyone out,
# which is the only way to revoke a session that exists.
SESSION_SECRET=

# Password reset is admin-issued, no email: `python -m app.cli issue-reset
# --email someone@example.com` prints a one-time link you pass to the person,
# and they choose a new password at /reset-password. FRONTEND_ORIGIN is the
# base of that link — the frontend's public URL, which this API never serves
# itself (same value as the CORS origin). The base compose file sets it to the
# local frontend automatically; production sets it from DOMAIN. Override here
# only for a non-standard local setup.
# FRONTEND_ORIGIN=http://localhost:3700

# Optional. The hosted sense ranker; without HF_TOKEN the ladder falls back to
# WordNet's own ordering. These must live here rather than in your shell:
# docker-compose.yml forwards only the variables it names into the backend.
HF_TOKEN=
HF_MODEL=sentence-transformers/all-MiniLM-L6-v2
LADDER_RANKING=on
