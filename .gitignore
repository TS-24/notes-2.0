# Keep this file UTF-8 without a BOM. It was previously UTF-16, which git reads
# as a literal "\xff\xfe" prefix on the first pattern, so not one line in it
# ever matched. That is how backend/venv, ~2,500 __pycache__ files and .env
# came to be tracked in a public repo.

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.venv-test/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# Editors and agents
.vscode/
.idea/
.gemini/
.claude/

# OS
.DS_Store
Thumbs.db

# Backups and scratch
*.bak
*.orig
.git.bak/

# One-shot WordNet loader, not part of the app. No __main__ guard, so importing
# it runs the whole load against a live database.
backend/app/services/run_once.py
